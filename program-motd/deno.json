{
  "name": "@my-web3-app/motd",
  "version": "1.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./lib/instructions.ts"
  },
  "tasks": {
    "start": "NODE_ENV=production deno run --allow-env --allow-read --allow-ffi --allow-sys --allow-net scripts/run.ts",
    "start:dev": "NODE_ENV=development deno run--allow-env --allow-read --allow-ffi --allow-sys --allow-net --watch scripts/run.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-net",
    "program:build": "bash ./build-program.sh",
    "program:deploy": "bash ./deploy-program.sh",
    "program:size": "du -A -B 1 program/target/deploy/motd.so"
  },
  "imports": {
    "@coral-xyz/borsh": "npm:@coral-xyz/borsh@^0.32.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "buffer": "npm:buffer@^6.0.3",
    "ejs": "npm:ejs@^4.0.1",
    "express": "npm:express@^5.2.1",
    "path": "npm:path@^0.12.7",
    "tsx": "npm:tsx@^4.21.0",
    "utils": "npm:utils@^0.3.1"
  }
}
