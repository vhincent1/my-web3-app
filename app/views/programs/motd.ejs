<% const { program, apiRoutes } = entry; %>

<%if (program.state?.is_initialized) {%>
Admin: <%= program.state.admin %> <br />
Current: <%= program.state.message %> <br />
<form action="/api<%= apiRoutes.update.path %>" method="POST">
  <label for="motd">Update (maxlength=512):</label> <br />
  <input type="hidden" name="variant" value="1">
  <textarea id="motd" name="userInput" rows="1" cols="30" maxlength="512"></textarea> <br />
  <!-- <input type="text" maxlength="512"></input> -->
  <input type="submit" value="Submit">
</form>
<%} else { %>
  <% const color = program.state.stage < 2 ? 'color:brown': 'color:green' %>
State: <span style="<%=color%>"><%= program.state.message %></span>
<form action="/api<%= apiRoutes.update.path %>" method="POST">
  <label for="motd">Initialize (maxlength=512):</label>
  <input type="hidden" name="variant" value="0">
  <!-- <textarea id="motd" name="userInput" rows="1" cols="30" maxlength="512"></textarea> <br /> -->
  <input type="text" name="userInput" maxlength="512"></input>
  <input type="submit" value="Submit">
</form>
<%}%>