<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/stylesheet.css">
</head>

<body>
  <h1>Dashboard</h1>
  <% if(session) { %>
  Session: publicKey=<%= session.publicKey %> userId=<%= session.userId %> <br />
