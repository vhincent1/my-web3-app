<% if (account) { %>
<div class="container" id="account">
  <h3>Account</h3>
  <p>Account: id=<%= account.id %> identifier=<%= account.identifier %> keypairs=<%= account.getWallet().addresses.length %></p>
  <br>
  <%- include('./inbox') %> <br>
  <%- include('./wallet') %> 
</div>
<% } else { %>
<div class="container" id="account">Account not found</div>
<% } %>