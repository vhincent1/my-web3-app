<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/stylesheet.css">
</head>

<body>
  <h1>Dashboard</h1>
  <!-- Session -->
  <div class="container" id="session">
    <% if(session) { %>
    Session: userId=<%= session.user.userId %> publicKey=<%= session.user.publicKey %>
    <% } else { %>
    Session not found (<a href="/login">Login</a>)
    <% } %>
  </div>
  <br>
  <% if(session) { %>
  <!-- Account -->
  <%- include('./account/index') %> <br>
  <!-- Programs -->
  <%- include('./programs/index', {tab}) %><br>
  <% } %>
  <!-- Accounts index -->
  <br>
  <div class="container" id="accounts">
    <h3>Accounts Index</h3>
  </div>
</body>

</html>